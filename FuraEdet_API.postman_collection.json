{
  "info": {
    "name": "ФураЕдет API",
    "description": "REST API для логистической платформы ФураЕдет",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://45.87.247.240.nip.io/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Аутентификация",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Иван Иванов\",\n  \"email\": \"ivan@example.com\",\n  \"phone\": \"+79001234567\",\n  \"password\": \"Password1!\"\n}"}
          }
        },
        {
          "name": "Подтверждение email (OTP)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/verify-email",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"code\": \"123456\",\n  \"purpose\": \"registration\"\n}"}
          }
        },
        {
          "name": "Повторная отправка OTP",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/resend-otp",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"purpose\": \"registration\"\n}"}
          }
        },
        {
          "name": "Вход",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"password\": \"Password1!\"\n}"}
          }
        },
        {
          "name": "Выход",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Профиль (me)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Обновить профиль",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/me",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Новое Имя\",\n  \"phone\": \"+79009999999\"\n}"}
          }
        },
        {
          "name": "Сброс пароля — запрос",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/password-reset",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"ivan@example.com\"\n}"}
          }
        },
        {
          "name": "Сброс пароля — подтверждение",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/password-reset/confirm",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"code\": \"123456\",\n  \"new_password\": \"NewPassword1!\"\n}"}
          }
        },
        {
          "name": "2FA — запрос включения/отключения",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/2fa/request",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"action\": \"enable\"\n}"}
          }
        },
        {
          "name": "2FA — верификация при входе",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/2fa/verify",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"code\": \"123456\"\n}"}
          }
        }
      ]
    },
    {
      "name": "Заказы",
      "item": [
        {
          "name": "Список заказов",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Создать заказ",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"origin_address\": \"Москва, ул. Ленина, 1\",\n  \"dest_address\": \"Санкт-Петербург, Невский пр., 10\",\n  \"weight\": 500,\n  \"volume\": 2.5,\n  \"cargo_type\": \"general\",\n  \"price\": 15000,\n  \"pickup_date\": \"2026-07-01\"\n}"}
          }
        },
        {
          "name": "Получить заказ",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/:id",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Обновить заказ",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/orders/:id",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"pending\"\n}"}
          }
        },
        {
          "name": "Удалить заказ",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/orders/:id",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Принять заказ (менеджер)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/accept",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Отклонить заказ (менеджер)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/reject",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"rejection_reason\": \"Груз не соответствует требованиям\"\n}"}
          }
        },
        {
          "name": "Назначить транспорт",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/assign-transport",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"truck_id\": 1,\n  \"driver_id\": 1\n}"}
          }
        },
        {
          "name": "Назначить курьера",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/assign-courier",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"courier_id\": 5\n}"}
          }
        },
        {
          "name": "Снять курьера",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders/:id/unassign-courier",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}]
          }
        },
        {
          "name": "Публичное отслеживание",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/track/:tracking_id"
          }
        }
      ]
    },
