# Настройки базы данных PostgreSQL
DB_NAME=fura_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# Django Secret Key (сгенерируйте свой для production!)
SECRET_KEY=django-insecure-j-%n2lm@1rm#qa*se)r7daklsujt4z3yh%rb_ws_#z5bo2k)$k

# Google Gemini API
# Получить ключ: https://makersuite.google.com/app/apikey
# Лимиты: 15 запросов/мин, 1500/день (бесплатно)
GEMINI_API_KEY=your_gemini_api_key_here

# YandexGPT API (РОССИЙСКИЙ, РЕКОМЕНДУЕТСЯ для России: бесплатный тариф, работает в РФ)
# Получить ключ: https://cloud.yandex.ru/ (нужен API-ключ и Folder ID)
# Инструкция: https://cloud.yandex.ru/docs/yandexgpt/quickstart
YANDEXGPT_API_KEY=your_yandexgpt_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# GigaChat API (Сбер, РОССИЙСКИЙ: бесплатный тариф, работает в России)
# Получить ключ: https://developers.sber.ru/gigachat (нужна регистрация)
GIGACHAT_API_KEY=your_gigachat_api_key_here

# Groq AI API (бесплатно, очень быстро, но может быть заблокирован в России)
# Получить ключ: https://console.groq.com/keys (ключи начинаются с gsk_)
GROQ_API_KEY=your_groq_api_key_here

# Grok AI API (xAI - модель Илона Маска, OpenAI-совместимый)
# Получить ключ: https://console.x.ai/ (ключи начинаются с xai-)
GROK_API_KEY=your_grok_api_key_here

# DeepSeek AI API (альтернатива Gemini, бесплатно но нужен баланс)
# Получить ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Yandex Maps API
# Получить ключ: https://developer.tech.yandex.ru/
YANDEX_MAPS_API_KEY=your_yandex_maps_api_key_here

# Debug режим (True для разработки, False для production)
DEBUG=True

# Разрешенные хосты (для production добавьте домен)
ALLOWED_HOSTS=localhost,127.0.0.1
